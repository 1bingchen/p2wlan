#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	local config=/etc/p2wlan/p2wlan-config.json
	local state=/var/run/p2wlan
	local enabled
	config_load p2wlan
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || {
		logger -t p2wlan 'reason=service_disabled; set p2wlan.main.enabled=1 to start'
		return 1
	}
	# A new installation has no identity or credentials. Boot must not create
	# one or start an authentication/respawn loop before the user logs in.
	[ -f "$config" ] || return 0
	[ ! -L "$config" ] && jsonfilter -i "$config" -e '@' >/dev/null || {
		logger -t p2wlan 'reason=invalid_config; expected a regular JSON config'
		return 1
	}
	if [ "$(jsonfilter -i "$config" -e '@.network.manual')" != true ]; then
		[ -n "$(jsonfilter -i "$config" -e '@.control.server_url')" ] && {
			[ -n "$(jsonfilter -i "$config" -e '@.control.device_credential')" ] ||
			[ -n "$(jsonfilter -i "$config" -e '@.control.auth_token')" ]
		} || {
			logger -t p2wlan 'reason=not_configured; run p2wlan config set control and p2wlan login'
			return 0
		}
	fi
	[ -c /dev/net/tun ] || {
		logger -t p2wlan 'reason=tun_unavailable; install the matching firmware kmod-tun'
		return 1
	}
	umask 077
	mkdir -p "$state" || return 1
	chmod 0700 /etc/p2wlan "$state" || return 1
	chmod 0600 "$config" || return 1
	procd_open_instance
	procd_set_param command /usr/bin/p2wlan-daemon --config "$config" --log-file "$state/p2wlan-daemon.log"
	procd_set_param file "$config"
	# At most five rapid crash restarts; normal network reconnects are owned
	# by the daemon. Stop through procd so its respawn state is removed first.
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 30
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger p2wlan
}
